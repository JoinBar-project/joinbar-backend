NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DEFAULT_PAGE_LIMIT=10
SERVICE_NAME=joinbar-backend
API_BASE_URL=http://localhost:3000

# ─── Database（PostgreSQL）───
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=joinbar_db
# DATABASE_URL 僅供 Prisma CLI 工具使用（prisma migrate dev / studio）
# DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}

# ─── JWT ───
ACCESS_SECRET=
ACCESS_TOKEN_EXPIRES_IN=7200
REFRESH_SECRET=
REFRESH_TOKEN_EXPIRES_IN=604800
SESSION_SECRET=

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=0
REDIS_URL=redis://localhost:6379

# ─── CORS ───
CORS_ORIGIN=*

# ─── Cookie ───
COOKIE_SECRET=

# ─── Firebase（Auth + Storage）───
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ─── LINE Login OAuth ───
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=http://localhost:3000/api/auth/line/callback

# ─── LINE Pay ───
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_CONFIRM_URL=http://localhost:3000/api/linepay/confirm
LINEPAY_CANCEL_URL=http://localhost:3000/api/linepay/cancel
LINEPAY_ENV=sandbox

# ─── Google Gemini AI ───
GEMINI_API_KEY=

# ─── Email SMTP ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM='"JoinBar" <noreply@joinbar.app>'

# ─── 權限快取 TTL（秒）───
PERMISSION_CACHE_TTL=300

# ─── bcrypt ───
BCRYPT_ROUNDS=10

# ─── 速率限制 ───
COMMON_RATE_LIMIT_WINDOW_MS=60000
COMMON_RATE_LIMIT_MAX_REQUESTS=100

# ─── 功能開關（Feature Flags）───
APPLICATION_AUTH_LOG_ENABLED=true
APPLICATION_EMAIL_VERIFICATION_ENABLED=true
APPLICATION_LINE_PAY_ENABLED=true
APPLICATION_GEMINI_ENABLED=true
APPLICATION_SUBSCRIPTION_ENABLED=true
APPLICATION_IP_WHITELIST_ENABLED=false
APPLICATION_IP_BLACKLIST_ENABLED=false
APPLICATION_ACCOUNT_LOCK_ENABLED=false
APPLICATION_PASSWORD_CHANGE_ENABLED=false
APPLICATION_SESSION_IDLE_ENABLED=false
APPLICATION_GOOGLE_RECAPTCHA_ENABLED=false
APPLICATION_API_LOG_ENABLED=true
APPLICATION_OPERATION_LOG_ENABLED=false

# ─── 密碼策略 ───
APPLICATION_PASSWORD_MIN_LENGTH=8
APPLICATION_PASSWORD_MAX_LENGTH=32
APPLICATION_PASSWORD_COMPLEXITY=1
APPLICATION_PASSWORD_CHANGE_PERIOD=6
APPLICATION_IS_LOGOUT_AFTER_PASSWORD_RESET=false

# ─── 帳號鎖定 ───
APPLICATION_ACCOUNT_LOCK_THRESHOLD=5
APPLICATION_IP_BLOCK_THRESHOLD=10

# ─── Google reCAPTCHA ───
GOOGLE_RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
GOOGLE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
GOOGLE_RECAPTCHA_VERSION=v2
GOOGLE_RECAPTCHA_IS_PRODUCTION=false

# ─── 閒置自動登出（分鐘）───
APPLICATION_SESSION_IDLE_TIMEOUT=120

# ─── 密碼重設 ───
APP_PASSWORD_RESET_TOKEN_EXPIRES_IN=30
APP_PASSWORD_RESET_URL=

# ─── Seed 預設帳號 ───
ADMIN_DEFAULT_EMAIL=admin@test.com
ADMIN_DEFAULT_PASSWORD=Admin1234!

# ─── 時區 ───
APP_TIMEZONE=Asia/Taipei
